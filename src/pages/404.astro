---
import Layout from "@layouts/Layout.astro"

const homeURL = import.meta.env.BASE_URL
---

<Layout
  title="404 · Page not found"
  titleZh="404 · 页面未找到"
  description="The requested page could not be found."
>
  <section class="grid min-h-[calc(100vh-8.5rem)] place-items-center py-16 text-center">
    <div class="max-w-lg">
      <p class="font-mono text-sm font-medium tracking-[0.22em] text-zinc-400">ERROR 404</p>
      <h1 class="mt-5 text-4xl font-bold tracking-[-0.045em] text-zinc-950 sm:text-6xl dark:text-zinc-50">
        <span class="lang-en">Page not found</span>
        <span class="lang-zh">页面未找到</span>
      </h1>
      <p class="mx-auto mt-5 max-w-md leading-7 text-zinc-500 dark:text-zinc-400">
        <span class="lang-en">The address may have changed, or the page may no longer exist.</span>
        <span class="lang-zh">这个地址可能已经变更，或者页面已被移除。</span>
      </p>
      <a
        href={homeURL}
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-full bg-zinc-950 px-5 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white"
      >
        <span class="lang-en">Return home</span>
        <span class="lang-zh">返回首页</span>
      </a>
    </div>
  </section>
</Layout>
