---
interface Props {
  name: "scholar" | "orcid" | "github" | "email"
  class?: string
}

const { name, class: className = "size-4" } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "scholar" && (
    <>
      <path d="M22 9 12 5 2 9l10 4 10-4v6" />
      <path d="M6 10.6V16a6 3 0 0 0 12 0v-5.4" />
    </>
  )}
  {name === "orcid" && (
    <>
      <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18" />
      <path d="M9 11v5M9 8v.01M12 8v8M12 8h1.5a2.5 2.5 0 0 1 2.5 2.5v3a2.5 2.5 0 0 1-2.5 2.5H12" />
    </>
  )}
  {name === "github" && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === "email" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </>
  )}
</svg>
